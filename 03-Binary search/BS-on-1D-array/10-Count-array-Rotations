#include<bits/stdc++.h>
using namespace std;

int Brutee_LS(vector<int>& arr,int n){

    int minvalue = arr[0];
    int index=-1;
    for(int i=0; i<n; i++){

        if(arr[i] < minvalue){
            minvalue = arr[i];
            index = i;
        }
    }
    return index;
}

int findKRotation(vector<int> &arr, int n)  {
    
    int low=0;
    int high=n-1;

    int ans = INT_MAX;
    int index = -1;

    while(low <= high){
        int mid = (low + high) / 2;

        if(arr[low] <= arr[high]){
            if(ans > arr[low]){
                ans = arr[low];
                index = low;
            }
            break;
        }

        if(arr[low] <= arr[mid]){
            if(ans > arr[low]){
                ans = arr[low];
                index = low;
            }
            low = mid +1;
        }
        else{
            if(ans > arr[mid]){
                ans = arr[mid];
                index = mid;
            }
            high = mid - 1;
        }
    }
    return index;
}

int main(){
    int n;
    cin>>n;

    vector<int> arr(n);
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }

    cout<<Brutee_LS(arr, n)<<" ";

    cout<<findKRotation(arr, n);

}